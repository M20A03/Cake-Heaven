rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for validation
    function hasRequiredOrderFields() {
      return request.resource.data.keys().hasAll([
        'customerName', 'customerPhone', 'deliveryAddress', 
        'cakeName', 'quantity', 'totalAmount', 'idempotencyKey', 'status', 'createdAt'
      ]);
    }

    function isValidQuantity() {
      return request.resource.data.quantity is int 
        && request.resource.data.quantity >= 1 
        && request.resource.data.quantity <= 10;
    }

    function isValidTotal() {
      return request.resource.data.totalAmount is number 
        && request.resource.data.totalAmount > 0;
    }

    // Cakes Catalog Collection
    match /cakes/{cakeId} {
      // Anyone can browse products catalog
      allow read: if true;
      // Only authorized admin can mutate cakes catalog
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Orders Collection
    match /orders/{orderId} {
      // Allow reading order history
      allow read: if true;

      // Allow creating orders with strict schema validation
      allow create: if hasRequiredOrderFields() 
                    && isValidQuantity() 
                    && isValidTotal()
                    && request.resource.data.status == 'Pending';

      // Updates and deletes restricted to admins
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}